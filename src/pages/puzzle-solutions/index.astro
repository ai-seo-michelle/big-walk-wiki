---
import { getEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { puzzleSolutionsPage } from "../../data/puzzleSolutions";

const entry = await getEntry("pages", "puzzle-solutions");

if (!entry) {
  throw new Error("Missing puzzle solutions content entry.");
}
---

<BaseLayout title={entry.data.title} description={entry.data.description} canonicalPath="/puzzle-solutions/">
  <main class="page-shell guide-page">
    <section class="page-hero guide-hero" aria-labelledby="puzzle-title">
      <div>
        <p class="eyebrow">{puzzleSolutionsPage.hero.eyebrow}</p>
        <h1 id="puzzle-title">{puzzleSolutionsPage.hero.title}</h1>
        <p class="lede">{puzzleSolutionsPage.hero.description}</p>
      </div>

      <aside class="source-card" aria-label={puzzleSolutionsPage.source.ariaLabel}>
        <p class="eyebrow">{puzzleSolutionsPage.source.eyebrow}</p>
        <h2>{puzzleSolutionsPage.source.title}</h2>
        <ul>
          {puzzleSolutionsPage.source.verifiedPoints.map((point) => <li>{point}</li>)}
        </ul>
      </aside>
    </section>

    <section class="guide-section" aria-labelledby="puzzle-introduction">
      <div class="section-heading">
        <p class="eyebrow">{puzzleSolutionsPage.overview.eyebrow}</p>
        <h2 id="puzzle-introduction">{puzzleSolutionsPage.overview.title}</h2>
      </div>
      <div class="guide-panel">
        {puzzleSolutionsPage.overview.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </section>

    <section class="guide-section" aria-labelledby="puzzle-solving-tips">
      <div class="section-heading">
        <p class="eyebrow">{puzzleSolutionsPage.solving.eyebrow}</p>
        <h2 id="puzzle-solving-tips">{puzzleSolutionsPage.solving.title}</h2>
      </div>
      <div class="step-list">
        {
          puzzleSolutionsPage.solving.steps.map((step, index) => (
            <article class="step-card">
              <span class="card-number">{index + 1}</span>
              <div>
                <h3>{step.title}</h3>
                <p>{step.text}</p>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="guide-section two-column-section" aria-labelledby="common-puzzle-types">
      <div>
        <p class="eyebrow">{puzzleSolutionsPage.approaches.eyebrow}</p>
        <h2 id="common-puzzle-types">{puzzleSolutionsPage.approaches.title}</h2>
        <p class="section-copy">{puzzleSolutionsPage.approaches.text}</p>
      </div>
      <div class="tip-grid">
        {
          puzzleSolutionsPage.approaches.items.map((approach) => (
            <article class="tip-card">
              <h3>{approach.title}</h3>
              <p>{approach.text}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="guide-section two-column-section" aria-labelledby="solution-database">
      <div>
        <p class="eyebrow">{puzzleSolutionsPage.database.eyebrow}</p>
        <h2 id="solution-database">{puzzleSolutionsPage.database.title}</h2>
        <p class="section-copy">{puzzleSolutionsPage.database.text}</p>
      </div>
      <ul class="check-list">
        {puzzleSolutionsPage.database.fields.map((field) => <li>{field}</li>)}
      </ul>
    </section>

    <section class="guide-section" aria-labelledby="community-discoveries">
      <div class="section-heading">
        <p class="eyebrow">{puzzleSolutionsPage.community.eyebrow}</p>
        <h2 id="community-discoveries">{puzzleSolutionsPage.community.title}</h2>
      </div>
      <div class="mistake-grid">
        {
          puzzleSolutionsPage.community.items.map((item) => (
            <article class="mistake-card">
              <p>{item}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="guide-note" aria-labelledby="puzzle-limitations">
      <div>
        <p class="eyebrow">{puzzleSolutionsPage.note.eyebrow}</p>
        <h2 id="puzzle-limitations">{puzzleSolutionsPage.note.title}</h2>
      </div>
      <p>{puzzleSolutionsPage.note.text}</p>
    </section>
  </main>
</BaseLayout>
