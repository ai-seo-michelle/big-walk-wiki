---
import { getEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const entry = await getEntry("pages", "puzzle-solutions");

if (!entry) {
  throw new Error("Missing puzzle solutions content entry.");
}

const verifiedPoints = [
  "Big Walk includes cooperative puzzle challenges.",
  "Puzzle solving is connected to exploration and teamwork.",
  "Communication between players is important when approaching challenges."
];

const solvingSteps = [
  {
    title: "Observe the Environment",
    text: "Look for interactive objects, hidden paths, possible mechanisms, and changes in the area before trying random actions."
  },
  {
    title: "Communicate With Teammates",
    text: "Share what each player can see, where objects are located, and which actions seem to affect the environment."
  },
  {
    title: "Try Team Roles",
    text: "One player can observe, another can test interactions, and another can track what changes after each attempt."
  }
];

const commonApproaches = [
  {
    title: "Environmental Clues",
    text: "Use visible paths, objects, and changes in the area as the first source of puzzle information."
  },
  {
    title: "Shared Perspective",
    text: "A puzzle may be easier when players compare what they can see from different positions."
  },
  {
    title: "Coordinated Testing",
    text: "Try one change at a time so the team can understand which action caused which result."
  }
];

const databaseFields = [
  "Puzzle Name",
  "Location",
  "Required Players",
  "Solution Steps",
  "Tips"
];

const unavailableItems = [
  "Complete puzzle database",
  "Puzzle-by-puzzle solutions",
  "Exact puzzle locations",
  "Unverified community shortcuts"
];
---

<BaseLayout title={entry.data.title} description={entry.data.description} canonicalPath="/puzzle-solutions/">
  <main class="page-shell guide-page">
    <section class="page-hero guide-hero" aria-labelledby="puzzle-title">
      <div>
        <p class="eyebrow">Big Walk Puzzle Guide</p>
        <h1 id="puzzle-title">Big Walk Puzzle Solutions</h1>
        <p class="lede">
          A verified-first puzzle guide for Big Walk, focused on cooperative
          problem solving, communication, and a future structure for confirmed solutions.
        </p>
      </div>

      <aside class="source-card" aria-label="Puzzle source status">
        <p class="eyebrow">Source Status</p>
        <h2>Verified for This Page</h2>
        <ul>
          {verifiedPoints.map((point) => <li>{point}</li>)}
        </ul>
      </aside>
    </section>

    <section class="guide-section" aria-labelledby="puzzle-introduction">
      <div class="section-heading">
        <p class="eyebrow">Overview</p>
        <h2 id="puzzle-introduction">Big Walk Puzzle Guide</h2>
      </div>
      <div class="guide-panel">
        <p>
          Big Walk uses cooperative puzzle challenges as part of its exploration
          experience. Current official and gameplay sources support the idea that
          puzzles are meant to be approached through teamwork and communication.
        </p>
        <p>
          This page does not publish specific puzzle answers yet. Exact puzzle
          locations, step-by-step solutions, and shortcuts should be added only
          after they are verified by reliable gameplay or community sources.
        </p>
      </div>
    </section>

    <section class="guide-section" aria-labelledby="puzzle-solving-tips">
      <div class="section-heading">
        <p class="eyebrow">How to Approach Puzzles</p>
        <h2 id="puzzle-solving-tips">Puzzle Solving Tips</h2>
      </div>
      <div class="step-list">
        {
          solvingSteps.map((step, index) => (
            <article class="step-card">
              <span class="card-number">{index + 1}</span>
              <div>
                <h3>{step.title}</h3>
                <p>{step.text}</p>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="guide-section two-column-section" aria-labelledby="common-puzzle-types">
      <div>
        <p class="eyebrow">General Patterns</p>
        <h2 id="common-puzzle-types">Common Puzzle Approaches</h2>
        <p class="section-copy">
          The wiki can safely explain general problem-solving patterns while it waits
          for reliable sources on individual puzzles.
        </p>
      </div>
      <div class="tip-grid">
        {
          commonApproaches.map((approach) => (
            <article class="tip-card">
              <h3>{approach.title}</h3>
              <p>{approach.text}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="guide-section two-column-section" aria-labelledby="solution-database">
      <div>
        <p class="eyebrow">Future Wiki Structure</p>
        <h2 id="solution-database">Puzzle Solutions Database</h2>
        <p class="section-copy">
          When confirmed puzzle data is available, each puzzle entry should follow
          a consistent structure so players can scan it quickly.
        </p>
      </div>
      <ul class="check-list">
        {databaseFields.map((field) => <li>{field}</li>)}
      </ul>
    </section>

    <section class="guide-section" aria-labelledby="community-discoveries">
      <div class="section-heading">
        <p class="eyebrow">Community Discoveries</p>
        <h2 id="community-discoveries">What Can Be Added Later?</h2>
      </div>
      <div class="mistake-grid">
        {
          unavailableItems.map((item) => (
            <article class="mistake-card">
              <p>{item}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="guide-note" aria-labelledby="puzzle-limitations">
      <div>
        <p class="eyebrow">Wiki Note</p>
        <h2 id="puzzle-limitations">No Unsupported Puzzle Answers</h2>
      </div>
      <p>
        Specific Big Walk puzzle solutions require additional verification from
        walkthrough videos, Reddit discussions, Discord community guides, or other
        reliable player sources. Until then, this page stays focused on safe,
        general puzzle-solving guidance.
      </p>
    </section>
  </main>
</BaseLayout>
