---
import { getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { homePage } from "../data/home";

const entry = await getEntry("pages", "home");

if (!entry) {
  throw new Error("Missing home content entry.");
}
---

<BaseLayout title={entry.data.title} description={entry.data.description} canonicalPath="/">
  <main class="home-shell">
    <section class="home-hero" aria-labelledby="home-title">
      <div class="hero-copy">
        <p class="eyebrow">{homePage.hero.eyebrow}</p>
        <h1 id="home-title" class="home-title">{homePage.hero.title}</h1>
        <p class="home-lede">{homePage.hero.description}</p>
        <div class="hero-actions" aria-label={homePage.hero.actionsLabel}>
          <a class="button button-primary" href={homePage.hero.primaryAction.href}>{homePage.hero.primaryAction.label}</a>
          <a class="button button-secondary" href={homePage.hero.secondaryAction.href}>{homePage.hero.secondaryAction.label}</a>
          <a class="button button-ghost" href={homePage.hero.tertiaryAction.href}>{homePage.hero.tertiaryAction.label}</a>
        </div>
        <ul class="hero-stats" aria-label={homePage.hero.statsLabel}>
          {homePage.hero.stats.map((stat) => <li>{stat}</li>)}
        </ul>
      </div>

      <aside class="hero-media" aria-label={homePage.media.ariaLabel}>
        <div class="media-heading">
          <p class="eyebrow">{homePage.media.eyebrow}</p>
          <h2>{homePage.media.title}</h2>
        </div>
        <div class="video-frame">
          <iframe
            src={homePage.media.src}
            title={homePage.media.iframeTitle}
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
          ></iframe>
        </div>
      </aside>
    </section>

    <section class="home-section" aria-labelledby="start-title">
      <div class="section-heading">
        <p class="eyebrow">{homePage.start.eyebrow}</p>
        <h2 id="start-title">{homePage.start.title}</h2>
      </div>
      <div class="start-grid">
        {
          homePage.start.cards.map((card) => (
            <a class="start-card" href={card.href}>
              <span class="card-number">{card.number}</span>
              <h3>{card.title}</h3>
              <p>{card.description}</p>
            </a>
          ))
        }
      </div>
    </section>

    <section class="about-section" aria-labelledby="about-title">
      <div class="about-copy">
        <p class="eyebrow">{homePage.about.eyebrow}</p>
        <h2 id="about-title">{homePage.about.title}</h2>
        {homePage.about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        <a class="button button-secondary" href={homePage.about.action.href}>{homePage.about.action.label}</a>
      </div>

      <dl class="about-stats">
        {
          homePage.about.stats.map((item) => (
            <div>
              <dt>{item.label}</dt>
              <dd>{item.value}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="final-cta" aria-labelledby="final-cta-title">
      <div>
        <p class="eyebrow">{homePage.cta.eyebrow}</p>
        <h2 id="final-cta-title">{homePage.cta.title}</h2>
        <p>{homePage.cta.text}</p>
      </div>
      <div class="final-actions">
        <a class="button button-primary" href={homePage.cta.primaryAction.href}>{homePage.cta.primaryAction.label}</a>
        <a class="button button-secondary" href={homePage.cta.secondaryAction.href}>{homePage.cta.secondaryAction.label}</a>
      </div>
    </section>
  </main>
</BaseLayout>
