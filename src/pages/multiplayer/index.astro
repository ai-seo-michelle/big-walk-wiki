---
import { getEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { multiplayerPage } from "../../data/multiplayer";

const entry = await getEntry("pages", "multiplayer");

if (!entry) {
  throw new Error("Missing multiplayer content entry.");
}
---

<BaseLayout title={entry.data.title} description={entry.data.description} canonicalPath="/multiplayer/">
  <main class="page-shell guide-page">
    <section class="page-hero guide-hero" aria-labelledby="multiplayer-title">
      <div>
        <p class="eyebrow">{multiplayerPage.hero.eyebrow}</p>
        <h1 id="multiplayer-title">{multiplayerPage.hero.title}</h1>
        <p class="lede">{multiplayerPage.hero.description}</p>
      </div>

      <aside class="source-card" aria-label={multiplayerPage.source.ariaLabel}>
        <p class="eyebrow">{multiplayerPage.source.eyebrow}</p>
        <h2>{multiplayerPage.source.title}</h2>
        <ul>
          {multiplayerPage.source.verifiedPoints.map((point) => <li>{point}</li>)}
        </ul>
      </aside>
    </section>

    <section class="guide-section" aria-labelledby="friends-overview">
      <div class="section-heading">
        <p class="eyebrow">{multiplayerPage.overview.eyebrow}</p>
        <h2 id="friends-overview">{multiplayerPage.overview.title}</h2>
      </div>
      <div class="guide-panel">
        {multiplayerPage.overview.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </section>

    <section class="guide-section" aria-labelledby="how-multiplayer-works">
      <div class="section-heading">
        <p class="eyebrow">{multiplayerPage.howItWorks.eyebrow}</p>
        <h2 id="how-multiplayer-works">{multiplayerPage.howItWorks.title}</h2>
      </div>
      <div class="step-list">
        {
          multiplayerPage.howItWorks.steps.map((step, index) => (
            <article class="step-card">
              <span class="card-number">{index + 1}</span>
              <div>
                <h3>{step.title}</h3>
                <p>{step.text}</p>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="guide-section two-column-section" aria-labelledby="cooperative-features">
      <div>
        <p class="eyebrow">{multiplayerPage.features.eyebrow}</p>
        <h2 id="cooperative-features">{multiplayerPage.features.title}</h2>
        <p class="section-copy">{multiplayerPage.features.text}</p>
      </div>
      <div class="tip-grid">
        {
          multiplayerPage.features.items.map((feature) => (
            <article class="tip-card">
              <h3>{feature.title}</h3>
              <p>{feature.text}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="guide-section two-column-section" aria-labelledby="multiplayer-tips">
      <div>
        <p class="eyebrow">{multiplayerPage.tips.eyebrow}</p>
        <h2 id="multiplayer-tips">{multiplayerPage.tips.title}</h2>
        <p class="section-copy">{multiplayerPage.tips.text}</p>
      </div>
      <ul class="check-list">
        {multiplayerPage.tips.items.map((tip) => <li>{tip}</li>)}
      </ul>
    </section>

    <section class="guide-section" aria-labelledby="multiplayer-faq">
      <div class="section-heading">
        <p class="eyebrow">{multiplayerPage.faq.eyebrow}</p>
        <h2 id="multiplayer-faq">{multiplayerPage.faq.title}</h2>
      </div>
      <div class="step-list">
        {
          multiplayerPage.faq.items.map((faq) => (
            <article class="step-card">
              <span class="card-number">?</span>
              <div>
                <h3>{faq.question}</h3>
                <p>{faq.answer}</p>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="guide-note" aria-labelledby="multiplayer-limitations">
      <div>
        <p class="eyebrow">{multiplayerPage.note.eyebrow}</p>
        <h2 id="multiplayer-limitations">{multiplayerPage.note.title}</h2>
      </div>
      <p>{multiplayerPage.note.text}</p>
    </section>
  </main>
</BaseLayout>
