---
import { getEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { mapMarkers } from "../../data/mapMarkers";
import { mapPage } from "../../data/mapPage";

const entry = await getEntry("pages", "map");

if (!entry) {
  throw new Error("Missing map content entry.");
}
---

<BaseLayout title={entry.data.title} description={entry.data.description} canonicalPath="/map/">
  <main class="page-shell guide-page">
    <section class="page-hero guide-hero" aria-labelledby="map-title">
      <div>
        <p class="eyebrow">{mapPage.hero.eyebrow}</p>
        <h1 id="map-title">{mapPage.hero.title}</h1>
        <p class="lede">{mapPage.hero.description}</p>
      </div>

      <aside class="source-card" aria-label={mapPage.source.ariaLabel}>
        <p class="eyebrow">{mapPage.source.eyebrow}</p>
        <h2>{mapPage.source.title}</h2>
        <ul>
          {mapPage.source.verifiedPoints.map((point) => <li>{point}</li>)}
        </ul>
      </aside>
    </section>

    <section class="guide-section" aria-labelledby="map-introduction">
      <div class="section-heading">
        <p class="eyebrow">{mapPage.overview.eyebrow}</p>
        <h2 id="map-introduction">{mapPage.overview.title}</h2>
      </div>
      <div class="guide-panel">
        {mapPage.overview.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </section>

    <section class="guide-section" aria-labelledby="interactive-map-status">
      <div class="section-heading">
        <p class="eyebrow">{mapPage.interactive.eyebrow}</p>
        <h2 id="interactive-map-status">{mapPage.interactive.title}</h2>
      </div>
      <div class="map-placeholder" role="group" aria-label={mapPage.interactive.placeholderLabel}>
        <div class="map-grid-area">
          <p class="eyebrow">{mapPage.interactive.markersEyebrow}</p>
          <strong>{mapMarkers.length}</strong>
          <span>{mapPage.interactive.markerSummary}</span>
        </div>
        <div class="map-sidebar">
          <h3>{mapPage.interactive.categoriesTitle}</h3>
          <ul>
            {mapPage.interactive.markerCategories.map((category) => <li>{category}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <section class="guide-section two-column-section" aria-labelledby="map-features">
      <div>
        <p class="eyebrow">{mapPage.features.eyebrow}</p>
        <h2 id="map-features">{mapPage.features.title}</h2>
        <p class="section-copy">{mapPage.features.text}</p>
      </div>
      <div class="tip-grid">
        {
          mapPage.features.items.map((feature) => (
            <article class="tip-card">
              <h3>{feature.title}</h3>
              <p>{feature.text}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="guide-section" aria-labelledby="exploration-guide">
      <div class="section-heading">
        <p class="eyebrow">{mapPage.exploration.eyebrow}</p>
        <h2 id="exploration-guide">{mapPage.exploration.title}</h2>
      </div>
      <div class="step-list">
        {
          mapPage.exploration.tips.map((tip, index) => (
            <article class="step-card">
              <span class="card-number">{index + 1}</span>
              <div>
                <h3>{tip.title}</h3>
                <p>{tip.text}</p>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="guide-section" aria-labelledby="community-discoveries">
      <div class="section-heading">
        <p class="eyebrow">{mapPage.community.eyebrow}</p>
        <h2 id="community-discoveries">{mapPage.community.title}</h2>
      </div>
      <div class="mistake-grid">
        {
          mapPage.community.items.map((item) => (
            <article class="mistake-card">
              <p>{item}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="guide-note" aria-labelledby="map-limitations">
      <div>
        <p class="eyebrow">{mapPage.note.eyebrow}</p>
        <h2 id="map-limitations">{mapPage.note.title}</h2>
      </div>
      <p>{mapPage.note.text}</p>
    </section>
  </main>
</BaseLayout>
