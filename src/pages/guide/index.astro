---
import { getEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { guidePage } from "../../data/guide";

const entry = await getEntry("pages", "guide");

if (!entry) {
  throw new Error("Missing guide content entry.");
}
---

<BaseLayout title={entry.data.title} description={entry.data.description} canonicalPath="/guide/">
  <main class="page-shell guide-page">
    <section class="page-hero guide-hero" aria-labelledby="guide-title">
      <div>
        <p class="eyebrow">{guidePage.hero.eyebrow}</p>
        <h1 id="guide-title">{guidePage.hero.title}</h1>
        <p class="lede">{guidePage.hero.description}</p>
      </div>

      <aside class="source-card" aria-label={guidePage.source.ariaLabel}>
        <p class="eyebrow">{guidePage.source.eyebrow}</p>
        <h2>{guidePage.source.title}</h2>
        <ul>
          {guidePage.source.verifiedPoints.map((point) => <li>{point}</li>)}
        </ul>
      </aside>
    </section>

    <section class="guide-section" aria-labelledby="what-is-big-walk">
      <div class="section-heading">
        <p class="eyebrow">{guidePage.overview.eyebrow}</p>
        <h2 id="what-is-big-walk">{guidePage.overview.title}</h2>
      </div>
      <div class="guide-panel">
        {guidePage.overview.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </section>

    <section class="guide-section" aria-labelledby="beginner-guide">
      <div class="section-heading">
        <p class="eyebrow">{guidePage.beginner.eyebrow}</p>
        <h2 id="beginner-guide">{guidePage.beginner.title}</h2>
      </div>
      <div class="step-list">
        {
          guidePage.beginner.steps.map((step, index) => (
            <article class="step-card">
              <span class="card-number">{index + 1}</span>
              <div>
                <h3>{step.title}</h3>
                <p>{step.text}</p>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="guide-section two-column-section" aria-labelledby="multiplayer-tips">
      <div>
        <p class="eyebrow">{guidePage.multiplayer.eyebrow}</p>
        <h2 id="multiplayer-tips">{guidePage.multiplayer.title}</h2>
        <p class="section-copy">{guidePage.multiplayer.text}</p>
      </div>
      <div class="tip-grid">
        {
          guidePage.multiplayer.tips.map((tip) => (
            <article class="tip-card">
              <h3>{tip.title}</h3>
              <p>{tip.text}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="guide-section two-column-section" aria-labelledby="puzzle-guide">
      <div>
        <p class="eyebrow">{guidePage.puzzles.eyebrow}</p>
        <h2 id="puzzle-guide">{guidePage.puzzles.title}</h2>
        <p class="section-copy">{guidePage.puzzles.text}</p>
      </div>
      <ul class="check-list">
        {guidePage.puzzles.tips.map((tip) => <li>{tip}</li>)}
      </ul>
    </section>

    <section class="guide-section" aria-labelledby="beginner-mistakes">
      <div class="section-heading">
        <p class="eyebrow">{guidePage.mistakes.eyebrow}</p>
        <h2 id="beginner-mistakes">{guidePage.mistakes.title}</h2>
      </div>
      <div class="mistake-grid">
        {
          guidePage.mistakes.items.map((mistake) => (
            <article class="mistake-card">
              <p>{mistake}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="guide-note" aria-labelledby="guide-limitations">
      <div>
        <p class="eyebrow">{guidePage.note.eyebrow}</p>
        <h2 id="guide-limitations">{guidePage.note.title}</h2>
      </div>
      <p>{guidePage.note.text}</p>
    </section>
  </main>
</BaseLayout>
