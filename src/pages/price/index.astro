---
import { getEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const entry = await getEntry("pages", "price");

if (!entry) {
  throw new Error("Missing price content entry.");
}

const verifiedPoints = [
  "Steam is an official store source for Big Walk purchase information.",
  "The official website can confirm official purchase links and announcements.",
  "Current price is dynamic and should be checked on official store pages."
];

const purchaseOptions = [
  {
    title: "Steam",
    text: "Use the Steam store page for PC purchase availability, current store information, price updates, user reviews, and system requirements.",
    href: "https://store.steampowered.com/app/1478500/Big_Walk/"
  },
  {
    title: "Official Website",
    text: "Use the official Big Walk website for first-party announcements, platform information, and official purchase guidance.",
    href: "https://bigwalk.game/"
  },
  {
    title: "Console Platforms",
    text: "Console availability and store links should be checked through official announcements or platform store pages before publishing details here.",
    href: "https://bigwalk.game/"
  }
];

const buyerFit = [
  {
    title: "Co-op Players",
    text: "Big Walk is a better fit for players looking for cooperative play rather than a solo-first action game."
  },
  {
    title: "Friend Groups",
    text: "The available materials point to a social experience built around teamwork, exploration, and communication."
  },
  {
    title: "Puzzle and Exploration Fans",
    text: "Players who enjoy shared discovery and problem solving are the most natural audience for Big Walk."
  }
];

const priceRules = [
  "Do not store one fixed long-term price on the wiki.",
  "Check official store pages for the latest price.",
  "Avoid publishing regional pricing unless it is verified.",
  "Treat discounts and sale prices as temporary information."
];

const faqs = [
  {
    question: "How much is Big Walk?",
    answer: "The current price can change by platform, region, and sale event. This page does not publish a fixed price; check the official store page for the latest price."
  },
  {
    question: "Where can I buy Big Walk?",
    answer: "Use official purchase channels such as the Steam store page and links provided by the official Big Walk website."
  },
  {
    question: "Does Big Walk support multiplayer?",
    answer: "Yes. Big Walk is described as a cooperative multiplayer adventure experience."
  },
  {
    question: "Is Big Walk available on console?",
    answer: "Platform availability should be confirmed through official announcements, official store pages, or the Big Walk website before adding detailed store links."
  }
];
---

<BaseLayout title={entry.data.title} description={entry.data.description} canonicalPath="/price/">
  <main class="page-shell guide-page">
    <section class="page-hero guide-hero" aria-labelledby="price-title">
      <div>
        <p class="eyebrow">Big Walk Price Guide</p>
        <h1 id="price-title">Big Walk Price</h1>
        <p class="lede">
          A verified-first purchase guide for Big Walk. This page explains where
          to check official store information without publishing an unverified or
          outdated fixed price.
        </p>
      </div>

      <aside class="source-card" aria-label="Price source status">
        <p class="eyebrow">Source Status</p>
        <h2>Verified for This Page</h2>
        <ul>
          {verifiedPoints.map((point) => <li>{point}</li>)}
        </ul>
      </aside>
    </section>

    <section class="guide-section" aria-labelledby="current-price">
      <div class="section-heading">
        <p class="eyebrow">Price Overview</p>
        <h2 id="current-price">Current Big Walk Price</h2>
      </div>
      <div class="guide-panel">
        <p>
          Big Walk pricing is dynamic. It can change by platform, region, and sale
          event, so this wiki should not store a fixed long-term price as permanent
          information.
        </p>
        <p>
          For the latest purchase information, players should check official store
          pages such as Steam and any official links shared by the Big Walk website.
        </p>
      </div>
    </section>

    <section class="guide-section" aria-labelledby="where-to-buy">
      <div class="section-heading">
        <p class="eyebrow">Official Channels</p>
        <h2 id="where-to-buy">Where to Buy Big Walk</h2>
      </div>
      <div class="step-list">
        {
          purchaseOptions.map((option, index) => (
            <article class="step-card">
              <span class="card-number">{index + 1}</span>
              <div>
                <h3>{option.title}</h3>
                <p>{option.text}</p>
                <a class="text-link" href={option.href}>Check official source</a>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="guide-section two-column-section" aria-labelledby="platform-availability">
      <div>
        <p class="eyebrow">Platforms</p>
        <h2 id="platform-availability">Platform Availability</h2>
        <p class="section-copy">
          Store and platform information should stay tied to official sources, since
          availability and storefront details can change over time.
        </p>
      </div>
      <ul class="check-list">
        {priceRules.map((rule) => <li>{rule}</li>)}
      </ul>
    </section>

    <section class="guide-section two-column-section" aria-labelledby="worth-buying">
      <div>
        <p class="eyebrow">Buyer Guide</p>
        <h2 id="worth-buying">Is Big Walk Worth Buying?</h2>
        <p class="section-copy">
          This is not a review score. It is a simple fit check based on the verified
          shape of Big Walk as a cooperative exploration and puzzle game.
        </p>
      </div>
      <div class="tip-grid">
        {
          buyerFit.map((item) => (
            <article class="tip-card">
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="guide-section" aria-labelledby="price-faq">
      <div class="section-heading">
        <p class="eyebrow">FAQ</p>
        <h2 id="price-faq">Price FAQ</h2>
      </div>
      <div class="step-list">
        {
          faqs.map((faq) => (
            <article class="step-card">
              <span class="card-number">?</span>
              <div>
                <h3>{faq.question}</h3>
                <p>{faq.answer}</p>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="guide-note" aria-labelledby="price-limitations">
      <div>
        <p class="eyebrow">Wiki Note</p>
        <h2 id="price-limitations">No Unverified Fixed Price</h2>
      </div>
      <p>
        This page intentionally avoids publishing a specific price until it can be
        checked against official store information. Future updates should verify
        price, discounts, and regional availability before adding them to the wiki.
      </p>
    </section>
  </main>
</BaseLayout>
