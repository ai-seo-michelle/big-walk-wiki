---
import { getEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { pricePage } from "../../data/price";

const entry = await getEntry("pages", "price");

if (!entry) {
  throw new Error("Missing price content entry.");
}
---

<BaseLayout title={entry.data.title} description={entry.data.description} canonicalPath="/price/">
  <main class="page-shell guide-page">
    <section class="page-hero guide-hero" aria-labelledby="price-title">
      <div>
        <p class="eyebrow">{pricePage.hero.eyebrow}</p>
        <h1 id="price-title">{pricePage.hero.title}</h1>
        <p class="lede">{pricePage.hero.description}</p>
      </div>

      <aside class="source-card" aria-label={pricePage.source.ariaLabel}>
        <p class="eyebrow">{pricePage.source.eyebrow}</p>
        <h2>{pricePage.source.title}</h2>
        <ul>
          {pricePage.source.verifiedPoints.map((point) => <li>{point}</li>)}
        </ul>
      </aside>
    </section>

    <section class="guide-section" aria-labelledby="current-price">
      <div class="section-heading">
        <p class="eyebrow">{pricePage.overview.eyebrow}</p>
        <h2 id="current-price">{pricePage.overview.title}</h2>
      </div>
      <div class="guide-panel">
        {pricePage.overview.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </section>

    <section class="guide-section" aria-labelledby="where-to-buy">
      <div class="section-heading">
        <p class="eyebrow">{pricePage.purchase.eyebrow}</p>
        <h2 id="where-to-buy">{pricePage.purchase.title}</h2>
      </div>
      <div class="step-list">
        {
          pricePage.purchase.options.map((option, index) => (
            <article class="step-card">
              <span class="card-number">{index + 1}</span>
              <div>
                <h3>{option.title}</h3>
                <p>{option.text}</p>
                <a class="text-link" href={option.href}>Check official source</a>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="guide-section two-column-section" aria-labelledby="platform-availability">
      <div>
        <p class="eyebrow">{pricePage.platform.eyebrow}</p>
        <h2 id="platform-availability">{pricePage.platform.title}</h2>
        <p class="section-copy">{pricePage.platform.text}</p>
      </div>
      <ul class="check-list">
        {pricePage.platform.rules.map((rule) => <li>{rule}</li>)}
      </ul>
    </section>

    <section class="guide-section two-column-section" aria-labelledby="worth-buying">
      <div>
        <p class="eyebrow">{pricePage.buyer.eyebrow}</p>
        <h2 id="worth-buying">{pricePage.buyer.title}</h2>
        <p class="section-copy">{pricePage.buyer.text}</p>
      </div>
      <div class="tip-grid">
        {
          pricePage.buyer.items.map((item) => (
            <article class="tip-card">
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="guide-section" aria-labelledby="price-faq">
      <div class="section-heading">
        <p class="eyebrow">{pricePage.faq.eyebrow}</p>
        <h2 id="price-faq">{pricePage.faq.title}</h2>
      </div>
      <div class="step-list">
        {
          pricePage.faq.items.map((faq) => (
            <article class="step-card">
              <span class="card-number">?</span>
              <div>
                <h3>{faq.question}</h3>
                <p>{faq.answer}</p>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="guide-note" aria-labelledby="price-limitations">
      <div>
        <p class="eyebrow">{pricePage.note.eyebrow}</p>
        <h2 id="price-limitations">{pricePage.note.title}</h2>
      </div>
      <p>{pricePage.note.text}</p>
    </section>
  </main>
</BaseLayout>
